# Rewind — environment variable NAMES only. No values, ever, in this file or in git.
# Copy to .env.local (gitignored) and fill in locally. See README-DEV.md for what each does.

# --- wiring -----------------------------------------------------------------
REWIND_REPO=                    # memory (dev only) | postgres
DATABASE_URL=                   # Neon connection string, required when REWIND_REPO=postgres
REWIND_CHAIN=                   # fake (dev) | lightclient (LOCAL testnet rehearsal) | rpc
REWIND_NETWORK=                 # testnet | mainnet (default). Decides networkId and explorer
NIMIQ_RPC_URL=                  # required when REWIND_CHAIN=rpc
NIMIQ_RPC_AUTHORIZATION=        # optional credential for a private node. Never logged
REWIND_VERIFIER=                # real | fake. fake is refused in production
REWIND_MERCHANT_AUTH=           # required | off. off is refused with a real chain

# --- the one secret ----------------------------------------------------------
# 64 hex characters. The Demo Store treasury signing key. Read only by TreasuryTxBuilder,
# never logged, never returned. For the rehearsal this is a TESTNET burner funded by a faucet.
REWIND_TREASURY_PRIVATE_KEY=

# --- addresses and limits -----------------------------------------------------
REWIND_TREASURY_ADDRESS=        # must be the address of REWIND_TREASURY_PRIVATE_KEY
REWIND_SAMPLE_MERCHANT_ADDRESS= # the non-treasury merchant
REWIND_NETWORK_ID=              # override; default 5 on testnet, 24 on mainnet
REWIND_MIN_CONFIRMATIONS=
REWIND_REFUND_FEE_LUNA=         # 0 = 1 Luna per signed byte
REWIND_CAP_PER_REFUND_LUNA=
REWIND_CAP_TOTAL_LUNA=
REWIND_TREASURY_FLOOR_LUNA=
REWIND_DEMO_AUTO_APPROVE=       # off turns the Demo Store back into a two-person flow
REWIND_EXPLORER_BASE=           # default follows REWIND_NETWORK

# --- test only ----------------------------------------------------------------
RUN_RPC_TESTS=                  # 1 enables the live read-only mainnet integration tests
REWIND_NO_EMBEDDED_PG=          # 1 forces the Postgres suite to skip
